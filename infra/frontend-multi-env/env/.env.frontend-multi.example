# Used by infra/frontend-multi-env/docker-compose.yml
# Copy to .env.frontend-multi on the Droplet and pass with:
#   docker compose --env-file .env.frontend-multi up -d --build

NEXT_PUBLIC_API_URL_PROD=https://api.sporgates.com/api
NEXT_PUBLIC_API_URL_QA=https://qa.api.sporgates.com/api
NEXT_PUBLIC_API_URL_DEV=https://dev.api.sporgates.com/api

# Optional: URL the Next.js Node process uses for rewrites (/uploads, /v1, /auth → API).
# Use the Docker service name or internal LB if NEXT_PUBLIC_* is only reachable from the browser (e.g. public hostname).
# Must still end with /api (same as backend context-path).
# INTERNAL_API_URL=http://sporgates-api:8080/api

# Server-side same-origin fetches (RSC, server actions) must hit the Next app so rewrites apply.
# Example: https://app.sporgates.com (omit trailing slash)
INTERNAL_APP_URL=

